{
  "manifest_version": 2,
  "version": "0.1.0",
  "name": "maibot-bridge-adapter",
  "description": "MaiBot 跨平台桥接房间路由插件",
  "author": {
    "name": "litroenade",
    "url": "https://github.com/litroenade"
  },
  "license": "GPL-v3.0",
  "urls": {
    "repository": "https://github.com/litroenade/maibot-bridge-adapter",
    "homepage": "https://github.com/litroenade/maibot-bridge-adapter",
    "documentation": "https://github.com/litroenade/maibot-bridge-adapter",
    "issues": "https://github.com/litroenade/maibot-bridge-adapter/issues"
  },
  "host_application": {
    "min_version": "0.0.0",
    "max_version": "0.0.0"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "llm.generate",
    "api.call",
    "api.list",
    "chat.get_stream_by_group_id",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "id": "maibot-bridge-adapter"
}
